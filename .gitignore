# Secrets - never committed, always read from environment at runtime
.env
.env.*
*.pem
*.key

# Movie Picker runtime output (regenerated by build_movie_picker.py)
movie-picker.html
movie-picker.json
cache/
posters/

# Movie Watcher runtime state
.movie-watcher/
watcher.lock
watcher.pid
stop.request

# Logs
*.log

# Actual media - this repo holds the tools, not the library
*.mp4
*.mkv
*.avi
*.m4v
*.mov
*.wmv
*.ts
*.m2ts
*.flv
*.webm
*.mpg
*.mpeg
*.srt
*.sub
*.ass
*.ssa
*.vtt

# Windows folder-icon artifacts (generated per movie folder, never source)
desktop.ini
folder.ico
poster.jpg
poster.png

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
*.stackdump

# Temporary / test artifacts
_watcher-test*/
*.part
*.tmp
